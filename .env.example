# Database (add a managed PostgreSQL URL before enabling persistence)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/amkart?sslmode=require"

# Authentication (to be configured in the secure backend phase)
AUTH_SECRET="replace-with-a-long-random-secret"

# Marketplace credentials must be stored server-side only.
AMAZON_CLIENT_ID=""
AMAZON_CLIENT_SECRET=""
AMAZON_REFRESH_TOKEN=""
FLIPKART_APP_ID=""
FLIPKART_APP_SECRET=""
